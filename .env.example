# sg-agent runtime secrets. Copy to `.env` and fill in. Bun auto-loads .env.
# The provider reads the key from the env var named in `apiKeyEnv`.
# NEVER commit .env. NEVER put real keys in this file.

# Primary provider (radon / DeepSeek-V4-Flash, openai-completions)
RADON_API_KEY=

# Fallback provider (das / gpt-5.6-terra, openai-responses) — optional
DAS_API_KEY=

# SingGuard sidecar
# Leave SG_MODEL_PATH empty to use <repo>/model after `python guard/download_model.py`.
SG_MODEL_PATH=
SG_CONDA_ENV=Audio
SG_GUARD_MODE=model

# Python used by swebench convert/evaluate (defaults to $CONDA_PREFIX or `python`)
SG_PYTHON=

# Hugging Face cache for the sidecar. Optional; defaults to ~/.cache/huggingface.
HF_HOME=
# After weights are cached locally you may set:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# SWE-bench test parquet (princeton-nlp/SWE-bench). Optional.
SWEBENCH_PARQUET=
